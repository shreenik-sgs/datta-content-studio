# Datta Content Studio only. Never point these at Sannidhi's database or host.
DISTRIBUTION_APP_ORIGIN=http://localhost:3070
DISTRIBUTION_HUB_ENABLED=false
DISTRIBUTION_HUB_STAGE=OFF
DISTRIBUTION_DATABASE_URL=
DISTRIBUTION_MIGRATION_DATABASE_URL=
# Own private storage outside this repository. Never put media under public/.
DISTRIBUTION_ASSET_BACKEND=local
DISTRIBUTION_ASSET_ROOT=
DISTRIBUTION_S3_BUCKET=
DISTRIBUTION_S3_REGION=ap-south-1
DISTRIBUTION_S3_EXPECTED_BUCKET_OWNER=
DISTRIBUTION_S3_PREFIX=test/
DISTRIBUTION_RENDER_SCRATCH_ROOT=
STUDIO_WORKER_ENABLED=false
STUDIO_GENERATION_ENABLED=false
STUDIO_PUBLISHING_ENABLED=false
STUDIO_INTELLIGENCE_PROVIDER=gemini
STUDIO_GEMINI_API_KEY=
STUDIO_GEMINI_MODEL=gemini-3.5-flash
STUDIO_TRANSCRIPTION_PROVIDER=sarvam
STUDIO_SARVAM_API_KEY=
STUDIO_SARVAM_MODEL=saaras:v4
STUDIO_SCRATCH_ROOT=
STUDIO_BRAND_LOGO_PATH=
STUDIO_CHANNEL_CONFIG_BACKEND=database
STUDIO_CHANNEL_CONFIG_KEY=
STUDIO_PUBLIC_ORIGIN=http://localhost:3070
STUDIO_MEDIA_SIGNING_SECRET=
STUDIO_ANALYTICS_ENABLED=false
STUDIO_NATIVE_ANALYSIS_ENABLED=false
# Optional independent live-channel inventory (JSON array); no Sannidhi OAuth reuse.
STUDIO_LIVE_CHANNELS_JSON=[]
# Optional destination integration for outreach; not needed for curation/publishing.
STUDIO_DESTINATION_ORIGIN=
# Add these only when running pnpm user:create. Remove the password afterward.
STUDIO_USER_EMAIL=
STUDIO_USER_NAME=
STUDIO_USER_PASSWORD=
STUDIO_USER_ROLES=CONTENT_COORDINATOR
