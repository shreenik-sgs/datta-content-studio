{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "noEmit": true,
    "composite": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true
  },
  "include": [".next-distribution/types/**/*.ts", "next-env.d.ts", "src/**/*"],
  "exclude": ["node_modules"],
  "references": [
    {
      "path": "../../packages/distribution-assets"
    },
    {
      "path": "../../packages/distribution-db"
    },
    {
      "path": "../../packages/distribution-domain"
    },
    {
      "path": "../../packages/distribution-contracts"
    },
    {
      "path": "../distribution-links"
    }
  ]
}
