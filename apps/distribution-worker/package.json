    "@satsang/distribution-domain": "workspace:*",
    "@satsang/distribution-links": "workspace:*",
    "pg": "^8.13.0",
    "playwright": "1.62.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "drizzle-orm": "^0.45.2",
    "tsx": "^4.19.0"
  }
}
