{
  "name": "@satsang/distribution-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node --import tsx src/index.ts",
    "studio:start": "node --import tsx src/studio-index.ts",
